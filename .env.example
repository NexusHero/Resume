# Copy this file to ".env" and fill in your secrets. ".env" is git-ignored.
# Loaded automatically by `npm run serve` / `npm start` (--env-file-if-exists).

# ── LLM provider (cover-letter generation) ────────────────────────────────
# Which provider writes the cover letters: "gemini" or "claude".
LLM_PROVIDER=gemini

# Google Gemini — paste your API key here (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
# Always use the cheap, fast Flash model.
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude (optional — only if you also want Claude available).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8

# Who the cover letter is authored as.
# CANDIDATE_NAME=Suhay Sevinc
# CANDIDATE_TITLE=M.Sc. Software Engineer

# ── Live job boards (optional) ────────────────────────────────────────────
# Without this the offline sample jobs are used.
# JOB_SOURCES=arbeitnow,bundesagentur,adzuna
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
