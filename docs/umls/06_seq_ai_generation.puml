@startuml 06_seq_ai_generation
title AI generation with grounding, central key & metering — no template fallback (FR-30/31/38, ADR-0057)

skinparam shadowing false
skinparam sequenceMessageAlign center
autonumber

actor Recruiter
participant "Controller" as Ctrl
participant "AiConfiguredGuard" as Guard
participant "AI feature service\n(e.g. OutreachAiService)" as Svc
participant "LlmFeatureRunner" as Runner
participant "LlmService\n→ central provider" as Llm
participant "grounding\n(domain, pure)" as Ground
participant "UsageMeter" as Meter

Recruiter -> Ctrl : POST /talents/:id/documents/pitch
activate Ctrl
Ctrl -> Guard : canActivate()
alt no central key (ANTHROPIC_API_KEY / GEMINI_API_KEY)
  Guard --> Ctrl : AiNotConfiguredError
  Ctrl --> Recruiter : 503 problem+json (ai-not-configured)
else central key configured
  Guard --> Ctrl : allow
  Ctrl -> Ctrl : zod-validate body
  Ctrl -> Svc : pitchForMandate(...)
  activate Svc

  Svc -> Runner : runFeature(feature, prompt, schema)
  activate Runner
  Runner -> Llm : active() — the server's central provider
  Llm --> Runner : provider
  Runner -> Llm : generate(prompt)
  alt generation fails / unusable reply
    Runner --> Svc : UpstreamProviderError
    Svc --> Ctrl : 502 problem+json
  else usable reply
    Llm --> Runner : raw reply
    Runner -> Runner : parseReply<T>() — schema validate
    Runner -> Meter : record(requests, tokens, cost)
    note right of Meter : metering never blocks;\nfailures are swallowed
    Runner --> Svc : { content, provider, usage }
  end
  deactivate Runner

  Svc -> Ground : checkGrounding(text, CV + mandate)
  Ground --> Svc : { supported, unsupported[] }
  Svc --> Ctrl : { …pitch, provider, usage, grounding }
  deactivate Svc
  Ctrl --> Recruiter : 200 — badge (AI·provider·tokens·$)\n+ "nicht belegte Angaben" if unsupported ≠ ∅
end
deactivate Ctrl

@enduml
