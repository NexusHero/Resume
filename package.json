{
  "name": "sevinc-cv",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Suhay Sevinc — CV & cover letter (self-contained HTML) + PDF export + REST API",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "serve": "tsx server/src/index.ts",
    "start": "node server/dist/index.js",
    "build": "tsc -p tsconfig.json",
    "pdf": "node tools/generate-pdf.cjs",
    "sent": "node tools/log-application.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docs:check": "node tools/check-docs.mjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js integration",
    "test:e2e": "playwright test",
    "test:web": "vitest run",
    "test:web:watch": "vitest",
    "package": "bash scripts/build-artifact.sh",
    "hooks:install": "git config core.hooksPath scripts/hooks && echo 'Git hooks installed (core.hooksPath=scripts/hooks)'",
    "build:web": "vite build",
    "cap:sync": "npm run build:web && cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1079.0",
    "awilix": "^13.0.5",
    "better-auth": "^1.6.23",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "imapflow": "^1.4.3",
    "nodemailer": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "puppeteer": "^25.2.1",
    "swagger-ui-dist": "^5.32.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-dist": "^3.30.6",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}
