#!/usr/bin/env bash
# Enforce Conventional Commits (English) on the commit message.
set -euo pipefail

MSG_FILE="$1"
# First non-empty, non-comment line.
SUBJECT="$(grep -vE '^\s*#' "$MSG_FILE" | grep -vE '^\s*$' | head -n1 || true)"

# Allow merge/revert/fixup commits to pass through.
if printf '%s' "$SUBJECT" | grep -qE '^(Merge|Revert|fixup!|squash!) '; then
  exit 0
fi

PATTERN='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,}$'

if ! printf '%s' "$SUBJECT" | grep -qE "$PATTERN"; then
  echo "✗ Commit message does not follow Conventional Commits." >&2
  echo "  Got:      $SUBJECT" >&2
  echo "  Expected: type(scope): summary    e.g. feat(api): add pagination" >&2
  echo "  Types:    feat fix docs style refactor perf test build ci chore revert" >&2
  exit 1
fi
