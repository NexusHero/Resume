{
  "compilerOptions": {
    "target": "ES2022",
    // ESM (ADR-0042): the server is native ESM so modern ESM-only packages load
    // without interop hacks. `nodenext` requires explicit .js extensions on
    // relative imports (the source uses them) and reads packages' exports maps.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "server/src",
    "outDir": "server/dist",
    "lib": ["ES2022"],
    "types": ["node", "jest"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // NestJS DI reads constructor param types at runtime via reflect-metadata
    // (ADR-0051). These two flags emit that metadata and enable the decorators
    // Nest's @Injectable/@Controller/@Inject rely on.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true
  },
  "include": ["server/src/**/*.ts"],
  "exclude": ["node_modules", "server/dist", "server/__tests__"]
}
